# Copy this file to .env.local and fill in your values
# DO NOT commit .env.local to Git

# MongoDB connection string
MONGODB_URI=mongodb://localhost:27017/qr-discount-system

# Session encryption key (minimum 32 characters)
# Generate with: openssl rand -hex 32
SESSION_SECRET=

# Public app URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Weekly data backup (see /api/cron/backup + vercel.json) ---
# GitHub personal access token with permission to push to the backup repo.
# Generate at https://github.com/settings/tokens - keep this secret.
GITHUB_BACKUP_TOKEN=
# The backup repo, as "owner/repo"
GITHUB_BACKUP_REPO=Ardeekew13/qr-discount-tracker-backup
# Random secret that authorizes Vercel Cron to call /api/cron/backup.
# Generate with: openssl rand -hex 32
CRON_SECRET=
